{
  "name": "l2-escape-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Measurement harness for L2 forced-inclusion / escape-hatch mechanisms",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "tsx src/cli/verify.ts",
    "snapshot": "tsx src/cli/verify.ts --json",
    "run": "tsx src/cli/run.ts",
    "export": "tsx src/cli/export.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
