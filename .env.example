# --- L1 ---
RPC_ETH_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com

# --- Mainnet observation (T13 indexer, READ-ONLY) ---
# Needs archive logs AND a wide eth_getLogs range. Measured 2026-09-11:
#   publicnode  - wide ranges, but archive depth is gated
#   Alchemy free- archive, but eth_getLogs capped at a 10-block range
#   drpc free   - archive at up to 10,000 blocks (2,000 is comfortable)
RPC_ETH_MAINNET=https://eth.drpc.org

# --- L2s ---
RPC_ARB_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
RPC_OP_SEPOLIA=https://sepolia.optimism.io
RPC_BASE_SEPOLIA=https://sepolia.base.org

